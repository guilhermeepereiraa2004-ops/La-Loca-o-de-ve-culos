# Configuração pública usada pelo navegador. Nunca coloque senhas ou secrets em VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# A chave pública do Supabase só é segura com autenticação e RLS no banco.
# Não adicionar service_role, senhas de usuários ou credenciais de pagamento aqui.

# Somente no servidor (Vercel): nunca adicionar prefixo VITE_ a estes valores.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key

# Proteção opcional do formulário: configurar AMBAS ou deixar AMBAS ausentes.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
