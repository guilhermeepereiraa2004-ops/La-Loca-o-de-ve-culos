VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Asaas API Key (Sandbox ou Produção)
# Coloque SOMENTE a parte após o "$" da chave fornecida pelo Asaas.
# Exemplo: se a chave for "$aact_hmlg_ABC123", coloque apenas "aact_hmlg_ABC123"
VITE_ASAAS_KEY_PREFIX=aact_hmlg_your_key_here
