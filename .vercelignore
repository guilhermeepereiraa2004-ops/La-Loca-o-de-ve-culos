scripts/
/*.cjs
/check_size.js
/resize.ps1
/db_dump*.json
/*.sql
/*.dump
/*.bak
/*.xlsx
/*.xls
/*.csv
/*.tsv
/*.doc
/*.docx
/*.pdf
/*.mp4
/*.zip
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*service-account*.json
/dist/
